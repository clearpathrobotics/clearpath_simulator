<?xml version="1.0"?>
<!--
  urdf2usd REFERENCE TESTBED (built on the A300).

  This file is a deliberately MAXIMAL configuration: it activates every
  <isaac_inputs> section and mounts one of every supported sensor type, so a
  single export exercises the whole pipeline end to end. The per-platform files
  (a300.urdf.xacro / j100.urdf.xacro / do100.urdf.xacro / do100_sensors.urdf.xacro)
  show the minimal real-world subset.

  The full attribute-by-attribute reference for <isaac_inputs> now lives in the
  urdf2usd package README:
      src/urdf2usd/README.md

  Export (inside the project's Isaac Sim container):
      ros2 run urdf2usd urdf2usd_export \
          - -xacro $(ros2 pkg prefix clearpath_isaac)/share/clearpath_isaac/urdf/example.urdf.xacro \
          - -output /tmp/example.usd - -keep-intermediates

  NOTE: the lidar and depth camera below use off-the-shelf vendor USD assets via
  the {nucleus} placeholder, so this export needs a reachable Nucleus server.
  Vanilla (asset-less) lidar/camera creation is not implemented yet; only the
  IMU works without an asset. Comment those two sensors out to export offline.

  The <isaac_inputs> block is only emitted when xacro is invoked with
  use_isaac:=true (the default). Setting use_isaac:=false produces a plain URDF
  that robot_state_publisher / ros2_control / Gazebo consume unchanged.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="a300_isaac">
  <xacro:arg name="use_isaac" default="true"/>

  <!-- Upstream Clearpath A300 description (4WD skid-steer). -->
  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/a300.urdf.xacro"/>
  <xacro:a300 control="diff_4wd" front_wheels="outdoor" rear_wheels="outdoor"/>

  <!--
    Dedicated sensor mount links so the testbed is self-contained (the bare A300
    only provides base_link, chassis_link, and default_mount). Each is massless
    and fixed to default_mount; merge_fixed_joints consolidates them into the
    surviving body and the sensor resolver locates them by name.
  -->
  <xacro:macro name="sensor_mount" params="name xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${name}">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-09" ixy="0.0" ixz="0.0" iyy="1e-09" iyz="0.0" izz="1e-09"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="default_mount"/>
      <child link="${name}"/>
    </joint>
  </xacro:macro>

  <xacro:sensor_mount name="imu_link"          xyz="0 0 0.05"/>
  <xacro:sensor_mount name="front_laser_link"  xyz="0.25 0 0.15"/>
  <xacro:sensor_mount name="front_camera_link" xyz="0.25 0 0.10"/>

  <!-- Isaac-Sim-only configuration. Ignored by all non-Isaac tooling. -->
  <xacro:if value="$(arg use_isaac)">
    <isaac_inputs>

      <!-- PhysX scene: run physics at 240 Hz with earth gravity. -->
      <physics_scene time_steps_per_second="240"
                     gravity="9.81"
                     friction_type="patch"/>

      <!-- URDF import settings (see README > import_config). -->
      <import_config
          merge_fixed_joints="true"
          fix_base="false"
          collision_from_visuals="false"/>

      <!-- Articulation root + articulation-level ROS 2 bridges. -->
      <articulation
          chassis_link="base_link"
          namespace="a300"
          clock="true"
          joint_states="true"      joint_states_topic="/joint_states"
          joint_commands="true"    joint_commands_topic="/joint_command"
          odom="true"              odom_topic="/odom"
          tf="true"                tf_topic="/tf"/>

      <!-- Reusable physics + visual material presets. -->
      <physics_material name="rubber"
                        static_friction="1.0"
                        dynamic_friction="0.9"
                        restitution="0.0"
                        friction_combine_mode="max"/>

      <visual_material name="wheel_black"
                       diffuse="0.05 0.05 0.05"
                       roughness="0.8"
                       metallic="0.0"/>

      <!-- Per-link material bindings. -->
      <link name="front_left_wheel_link"  physics_material="rubber" visual_material="wheel_black"/>
      <link name="front_right_wheel_link" physics_material="rubber" visual_material="wheel_black"/>
      <link name="rear_left_wheel_link"   physics_material="rubber" visual_material="wheel_black"/>
      <link name="rear_right_wheel_link"  physics_material="rubber" visual_material="wheel_black"/>

      <!-- Reusable per-joint preset + bindings (velocity-controlled diff drive). -->
      <joint_properties name="diff_drive_wheel"
                        control_mode="velocity"
                        drive_type="force"
                        stiffness="0.0"
                        damping="1000.0"
                        max_effort="100.0"
                        max_velocity="20.0"/>
      <joint name="front_left_wheel_joint"  properties="diff_drive_wheel"/>
      <joint name="front_right_wheel_joint" properties="diff_drive_wheel"/>
      <joint name="rear_left_wheel_joint"   properties="diff_drive_wheel"/>
      <joint name="rear_right_wheel_joint"  properties="diff_drive_wheel"/>

      <!-- ============================ SENSORS ============================ -->
      <!-- See README > sensors for every attribute + default. -->

      <!-- IMU: basic sensor (no config). Publishes sensor_msgs/Imu when
           ros2="true". -->
      <sensor name="imu"
              type="imu"
              link="imu_link"
              ros2="true"
              topic="imu"
              frame_id="imu_link"
              frequency="60.0"/>

      <!-- RTX lidar: SICK microScan3 (2D laser scan) created from its config
           name. Drop config to get the default Example_Rotary basic lidar, or
           set config="OS1" variant="..." for another device. Numeric attrs like
           max_range override the config's baked scan pattern. -->
      <sensor name="front_lidar"
              type="rtx_lidar"
              link="front_laser_link"
              config="SICK_microScan3"
              ros2="true"
              frame_id="front_laser_link"
              laser_scan="true"  laser_scan_topic="front_laser/scan"
              point_cloud="false"
              max_range="40.0"/>

      <!-- Depth camera: off-the-shelf Intel RealSense D455 (rgb + depth + pcl). -->
      <sensor name="front_camera"
              type="depth_camera"
              link="front_camera_link"
              asset="{nucleus}/Isaac/Sensors/RealSense/D455/rsd455.usd"
              ros2="true"
              frame_id="front_camera_optical_frame"
              rgb="true"        rgb_topic="front_camera/color/image_raw"
              depth="true"      depth_topic="front_camera/depth/image_rect_raw"
              depth_pcl="true"  depth_pcl_topic="front_camera/depth/points"
              rgb_camera_info_topic="front_camera/color/camera_info"
              depth_camera_info_topic="front_camera/depth/camera_info"
              frequency="30.0"/>

    </isaac_inputs>
  </xacro:if>

</robot>
